# Public browser values: safe to expose. Point these ONLY at a new Supabase project.
VITE_SUPABASE_URL=https://YOUR_NEW_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_NEW_PROJECT_ANON_KEY

# Netlify server-only environment variables. Never use the VITE_ prefix for secrets.
SUPABASE_SERVICE_ROLE_KEY=YOUR_NEW_PROJECT_SERVICE_ROLE_KEY

# Only needed if completing callbacks for Billplz bills created before checkout was disabled.
BILLPLZ_COLLECTION_ID=YOUR_OLD_BILLPLZ_COLLECTION_ID
BILLPLZ_X_SIGNATURE_KEY=YOUR_OLD_BILLPLZ_X_SIGNATURE_KEY
